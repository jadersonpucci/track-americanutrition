{%- comment -%}
  America Nutrition · Black Friday (home). Secao propria do tema, editavel no editor da Shopify.
  Aparece entre "Mostrar a partir de" e o fim da campanha; no editor do tema aparece sempre.
  Topo com contagem, kits do ImunoFosfo (precos nos campos da secao) e ofertas da linha (blocos de produto:
  foto, nome e preco atual vem da loja; o preco da campanha vem do campo do bloco).
{%- endcomment -%}
{%- liquid
  assign bf_show = false
  if section.settings.ativo
    assign bf_agora = 'now' | date: '%s' | plus: 0
    assign bf_desde = section.settings.mostrar_desde | append: ' 00:00:00 -0300' | date: '%s' | plus: 0
    assign bf_fim = section.settings.fim | append: ' 23:59:59 -0300' | date: '%s' | plus: 0
    if section.settings.mostrar_desde == blank or bf_agora >= bf_desde
      if bf_agora <= bf_fim
        assign bf_show = true
      endif
    endif
  endif
  if request.design_mode
    assign bf_show = true
  endif
  assign bf_prod = section.settings.produto_kits
-%}
{%- if bf_show -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&display=swap" rel="stylesheet">
<style>
  .anbf{--bg:#F4F6FB;--card:#FFFFFF;--navy:#07388E;--navyhi:#1656C9;--red:#D9121B;--reddeep:#AD0404;--fg:#0F1B33;--muted:#5B6475;--line:#E1E6F0;
    --d:"Barlow Condensed","Arial Narrow",Arial,sans-serif;background:var(--bg);color:var(--fg);font-family:var(--font-body-family,Inter),Arial,sans-serif;line-height:1.55;overflow:hidden}
  .anbf *{box-sizing:border-box}
  .anbf a{color:inherit;text-decoration:none}
  .anbf-w{max-width:1200px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
  .anbf h2,.anbf h3{font-family:var(--d);margin:0;letter-spacing:.2px;text-wrap:balance;color:inherit}
  .anbf-eb{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--red)}
  .anbf-num{font-variant-numeric:tabular-nums}
  .anbf-hero .anbf-eb{color:#fff}.anbf-hero .anbf-bars i{background:#fff}.anbf-hero .anbf-bars i:nth-child(2){background:var(--red)}
  .anbf-bars{display:inline-grid;gap:4px;width:34px}.anbf-bars i{display:block;height:5px;background:var(--red);border-radius:1px}.anbf-bars i:nth-child(3){width:82%;justify-self:end}
  .anbf-btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:15px 26px;font-weight:700;font-size:15px;border:0;transition:background .15s}
  .anbf-btn--red{background:var(--red);color:#fff!important}.anbf-btn--red:hover{background:#F2232C}
  .anbf-btn--ghost{border:1.5px solid var(--navy);color:var(--navy)!important;background:transparent}.anbf-btn--ghost:hover{background:var(--navy);color:#fff!important}
  .anbf-hero .anbf-btn--ghost{border-color:rgba(255,255,255,.6);color:#fff!important}.anbf-hero .anbf-btn--ghost:hover{background:#fff;color:var(--navy)!important}
  /* hero */
  .anbf-hero{color:#fff;background:radial-gradient(800px 500px at 80% 25%,#2A6BE0 0,rgba(42,107,224,0) 62%),radial-gradient(520px 360px at 6% 105%,rgba(217,18,27,.45),rgba(217,18,27,0) 70%),linear-gradient(160deg,#0A47B0 0%,#07388E 55%,#052C70 100%)}
  .anbf-hero .anbf-w{display:grid;grid-template-columns:1.15fr .85fr;gap:24px;align-items:center;padding-block:48px 40px}
  .anbf-k{display:flex;align-items:center;gap:12px}
  .anbf-mega{font-family:var(--d);font-size:clamp(72px,12vw,160px);line-height:.82;font-weight:900;text-transform:uppercase;letter-spacing:-1px;margin:18px 0 0}
  .anbf-mega span{display:block}.anbf-mega .o{color:transparent;-webkit-text-stroke:2px #fff}.anbf-mega .r{color:#fff;background:var(--red);display:inline-block;padding:4px 14px 0;border-radius:10px;transform:rotate(-2deg);margin-top:8px}
  .anbf-lead{font-size:18px;color:#DCE6FA;max-width:36ch;margin:20px 0 0}.anbf-lead p{margin:0}.anbf-lead strong{color:#fff}
  .anbf-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
  .anbf-art{position:relative;display:grid;place-items:center;min-height:400px}
  .anbf-art .ring{position:absolute;width:min(400px,90%);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.22),rgba(255,255,255,0) 68%);border:1px dashed rgba(255,255,255,.35)}
  .anbf-art img{position:relative;width:min(240px,58%);height:auto;filter:drop-shadow(0 26px 34px rgba(3,20,60,.55));transform:rotate(-4deg)}
  .anbf-stamp{position:absolute;top:6%;right:6%;width:128px;aspect-ratio:1;border-radius:50%;background:var(--red);display:grid;place-items:center;text-align:center;transform:rotate(10deg);box-shadow:0 10px 30px rgba(224,22,31,.45);font-family:var(--d);font-weight:900;line-height:.9}
  .anbf-stamp b{font-size:44px;display:block}.anbf-stamp small{font-size:13px;letter-spacing:1.5px;text-transform:uppercase}
  .anbf-tag{position:absolute;bottom:8%;left:4%;background:#fff;color:#0F1B33;border-radius:12px;padding:12px 16px 12px 22px;box-shadow:0 14px 30px rgba(3,20,60,.35);transform:rotate(-3deg)}
  .anbf-tag small{display:block;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#5B6475}
  .anbf-tag s{color:#8A94A6;font-size:13px}.anbf-tag strong{font-family:var(--d);font-size:34px;line-height:1;color:var(--reddeep);display:block}
  /* contagem */
  .anbf-cd{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:24px}
  .anbf-cd .l{font-weight:600;color:#DCE6FA;margin-right:4px;font-size:14px}
  .anbf-u{min-width:66px;text-align:center;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.28);border-radius:10px;padding:8px 6px 6px}
  .anbf-u b{display:block;font-family:var(--d);font-size:34px;line-height:1;font-weight:800}
  .anbf-u span{font-size:10px;letter-spacing:1.2px;text-transform:uppercase;color:#C9D6F2}
  /* blocos */
  .anbf-sec{padding-block:56px}
  .anbf-sh{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:26px}
  .anbf-sh h2{font-size:clamp(34px,5vw,52px);line-height:.95;font-weight:800;text-transform:uppercase;color:var(--navy)}
  .anbf-sh p{color:var(--muted);max-width:46ch;margin:0}
  .anbf-kits{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .anbf-kit{position:relative;background:var(--card);border:1.5px solid var(--line);box-shadow:0 2px 10px rgba(7,56,142,.06);border-radius:14px;padding:22px;display:grid;gap:12px;align-content:start;min-width:0;transition:border-color .15s}
  .anbf-kit:hover{border-color:var(--navy)}
  .anbf-kit.is-top{border-color:var(--red);background:linear-gradient(180deg,#FFF1F1,#fff 55%);box-shadow:0 10px 26px rgba(217,18,27,.12)}
  .anbf-flag{position:absolute;top:-12px;left:20px;background:var(--red);color:#fff;font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;padding:4px 10px;border-radius:6px}
  .anbf-bt{display:flex;align-items:flex-end;height:104px}.anbf-bt img{width:54px;height:auto;margin-right:-20px;filter:drop-shadow(0 6px 8px rgba(7,56,142,.25))}
  .anbf-kit h3{font-size:30px;font-weight:800;text-transform:uppercase;line-height:1;color:var(--navy)}
  .anbf-dur{font-size:13px;color:var(--muted)}.anbf-dur b{color:var(--fg)}
  .anbf-pr{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}.anbf-pr s{color:var(--muted);font-size:14px}
  .anbf-pr strong{font-family:var(--d);font-size:44px;line-height:1;font-weight:800;color:var(--reddeep)}
  .anbf-unit{font-size:13px;color:var(--muted)}
  .anbf-save{justify-self:start;font-size:12px;font-weight:700;color:var(--reddeep);background:#FFE9E9;border:1px solid #F7C3C3;border-radius:999px;padding:3px 10px}
  .anbf-kit .anbf-btn{margin-top:4px}
  .anbf-note{font-size:12px;color:var(--muted);margin-top:12px}
  .anbf-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .anbf-card{background:var(--card);color:var(--fg);border:1px solid var(--line);box-shadow:0 2px 10px rgba(7,56,142,.06);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
  .anbf-ph{position:relative;background:#fff;aspect-ratio:1;display:grid;place-items:center}
  .anbf-ph img{width:82%;height:auto}
  .anbf-off{position:absolute;top:12px;left:12px;background:var(--red);color:#fff;font-family:var(--d);font-weight:800;font-size:18px;padding:2px 9px;border-radius:6px}
  .anbf-bd{border-top:1px solid var(--line);padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
  .anbf-bd h3{font-size:21px;font-weight:700;line-height:1.1}
  .anbf-pp{margin-top:auto;padding-top:6px;display:flex;align-items:baseline;gap:8px}.anbf-pp s{font-size:13px;color:#8A94A6}
  .anbf-pp strong{font-family:var(--d);font-size:28px;font-weight:800;color:var(--reddeep)}
  .anbf-add{margin-top:8px;border-radius:999px;background:var(--navy);color:#fff!important;font-weight:700;font-size:14px;padding:11px 14px;text-align:center}.anbf-add:hover{background:var(--navyhi)}
  .anbf-tl{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card)}
  .anbf-ph3{padding:22px;border-right:1px solid var(--line);min-width:0}.anbf-ph3:last-child{border-right:0}
  .anbf-ph3.on{background:#FFF1F1}
  .anbf-ph3 .w{font-family:var(--d);font-size:15px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted)}.anbf-ph3.on .w{color:var(--red)}
  .anbf-ph3 h3{font-size:28px;font-weight:800;text-transform:uppercase;margin:6px 0 8px;color:var(--navy)}
  .anbf-ph3 p{margin:0;color:var(--muted);font-size:14px}
  @media (max-width:990px){.anbf-grid{grid-template-columns:repeat(3,1fr)}}
  @media (max-width:749px){
    .anbf-hero .anbf-w{grid-template-columns:1fr;padding-block:28px}
    .anbf-art{min-height:340px;order:-1;padding-top:18px}.anbf-art img{width:min(190px,48%)}.anbf-stamp{width:96px;top:10%}.anbf-stamp b{font-size:32px}.anbf-tag{bottom:6%}
    .anbf-cd{gap:8px}.anbf-cd .l{flex-basis:100%}.anbf-u{flex:1;min-width:0}.anbf-u b{font-size:30px}
    .anbf-kits{grid-template-columns:1fr}.anbf-grid{grid-template-columns:repeat(2,1fr);gap:12px}
    .anbf-bd h3{font-size:18px}.anbf-pp strong{font-size:24px}
    .anbf-tl{grid-template-columns:1fr}.anbf-ph3{border-right:0;border-bottom:1px solid var(--line)}.anbf-ph3:last-child{border-bottom:0}
    .anbf-sec{padding-block:44px}
  }
</style>

<section class="anbf" id="black-friday" aria-label="Black Friday" data-inicio="{{ section.settings.inicio }}" data-fim="{{ section.settings.fim }}" data-cyber="{{ section.settings.cyber }}">
  <div class="anbf-hero">
    <div class="anbf-w">
      <div>
        <div class="anbf-k"><span class="anbf-bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="anbf-eb">{{ section.settings.datas_txt | escape }}</span></div>
        <h2 class="anbf-mega"><span class="o">Black</span><span>Friday</span><span class="r">{{ section.settings.desconto_max | escape }}</span></h2>
        <div class="anbf-lead">{{ section.settings.lead }}</div>
        <div class="anbf-cta">
          <a class="anbf-btn anbf-btn--red" href="#anbf-kits">Ver os kits</a>
          <a class="anbf-btn anbf-btn--ghost" href="#anbf-linha">Ofertas da linha toda</a>
        </div>
        <div class="anbf-cd" aria-live="off">
          <span class="l" data-bf-rotulo>Começa em</span>
          <div class="anbf-u"><b class="anbf-num" data-bf="d">--</b><span>dias</span></div>
          <div class="anbf-u"><b class="anbf-num" data-bf="h">--</b><span>horas</span></div>
          <div class="anbf-u"><b class="anbf-num" data-bf="m">--</b><span>min</span></div>
          <div class="anbf-u"><b class="anbf-num" data-bf="s">--</b><span>seg</span></div>
        </div>
      </div>
      <div class="anbf-art" aria-hidden="true">
        <div class="ring"></div>
        <img src="{{ 'an-bf-frasco.png' | asset_url }}" alt="" width="278" height="522" loading="eager">
        <div class="anbf-stamp"><div><b>{{ section.settings.desconto_max | escape }}</b><small>no kit 6</small></div></div>
        <div class="anbf-tag"><small>Kit 6 · por frasco</small><s>{{ section.settings.preco_cheio | escape }}</s><strong class="anbf-num">{{ section.settings.kit6_unit | escape }}</strong></div>
      </div>
    </div>
  </div>

  <div class="anbf-sec" id="anbf-kits">
    <div class="anbf-w">
      <div class="anbf-sh">
        <div><div class="anbf-eb">ImunoFosfo · 90 cápsulas</div><h2>Escolha quantos meses<br>de protocolo</h2></div>
        <p>Na fase de manutenção (3 cápsulas por dia), cada frasco de 90 cápsulas dura 30 dias. Quanto mais meses você garante agora, menor o preço por frasco.</p>
      </div>
      {%- assign bf_url = '/products/imunofosfo-fosfoetanolamina-phospho' -%}
      {%- if bf_prod != blank -%}{%- assign bf_url = bf_prod.url -%}{%- endif -%}
      <div class="anbf-kits">
        <a class="anbf-kit" href="{{ bf_url }}">
          <div class="anbf-bt" aria-hidden="true"><img src="{{ 'an-bf-frasco.png' | asset_url }}" alt="" width="54" height="102" loading="lazy"></div>
          <h3>1 frasco</h3><div class="anbf-dur"><b>1 mês</b> de manutenção</div>
          <div class="anbf-pr"><s class="anbf-num">{{ section.settings.preco_cheio | escape }}</s><strong class="anbf-num">{{ section.settings.kit1_total | escape }}</strong></div>
          <div class="anbf-unit">{{ section.settings.kit1_total | escape }} por frasco</div>
          <span class="anbf-save">{{ section.settings.kit1_off | escape }}</span>
          <span class="anbf-btn anbf-btn--ghost">Comprar 1 frasco</span>
        </a>
        <a class="anbf-kit is-top" href="{{ bf_url }}">
          <span class="anbf-flag">Mais escolhido</span>
          <div class="anbf-bt" aria-hidden="true">{%- for i in (1..3) -%}<img src="{{ 'an-bf-frasco.png' | asset_url }}" alt="" width="54" height="102" loading="lazy">{%- endfor -%}</div>
          <h3>Kit 3</h3><div class="anbf-dur"><b>3 meses</b> de manutenção</div>
          <div class="anbf-pr"><s class="anbf-num">{{ section.settings.kit3_de | escape }}</s><strong class="anbf-num">{{ section.settings.kit3_total | escape }}</strong></div>
          <div class="anbf-unit">{{ section.settings.kit3_unit | escape }} por frasco</div>
          <span class="anbf-save">{{ section.settings.kit3_off | escape }}</span>
          <span class="anbf-btn anbf-btn--red">Garantir o Kit 3</span>
        </a>
        <a class="anbf-kit" href="{{ bf_url }}">
          <span class="anbf-flag">Menor preço</span>
          <div class="anbf-bt" aria-hidden="true">{%- for i in (1..6) -%}<img src="{{ 'an-bf-frasco.png' | asset_url }}" alt="" width="54" height="102" loading="lazy">{%- endfor -%}</div>
          <h3>Kit 6</h3><div class="anbf-dur"><b>6 meses</b> de manutenção</div>
          <div class="anbf-pr"><s class="anbf-num">{{ section.settings.kit6_de | escape }}</s><strong class="anbf-num">{{ section.settings.kit6_total | escape }}</strong></div>
          <div class="anbf-unit">{{ section.settings.kit6_unit | escape }} por frasco</div>
          <span class="anbf-save">{{ section.settings.kit6_off | escape }}</span>
          <span class="anbf-btn anbf-btn--ghost">Garantir o Kit 6</span>
        </a>
      </div>
      <p class="anbf-note">{{ section.settings.nota_kits | escape }}</p>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="anbf-sec" id="anbf-linha" style="padding-top:8px">
    <div class="anbf-w">
      <div class="anbf-sh">
        <div><div class="anbf-eb">Linha completa</div><h2>Ofertas em toda a loja</h2></div>
        <p>Monte o seu pedido: acima de R$ 250 o frete sai grátis.</p>
      </div>
      <div class="anbf-grid">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.produto -%}
          {%- if p != blank -%}
          <article class="anbf-card" {{ block.shopify_attributes }}>
            <a class="anbf-ph" href="{{ p.url }}">
              {%- if block.settings.off != blank -%}<span class="anbf-off">{{ block.settings.off | escape }}</span>{%- endif -%}
              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title, widths: '300,450,600' }}{%- endif -%}
            </a>
            <div class="anbf-bd">
              <h3>{{ block.settings.nome | default: p.title | escape }}</h3>
              <div class="anbf-pp"><s class="anbf-num">{{ p.price | money }}</s><strong class="anbf-num">{{ block.settings.preco_bf | escape }}</strong></div>
              <a class="anbf-add" href="{{ p.url }}">Ver oferta</a>
            </div>
          </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="anbf-sec" style="padding-top:8px">
    <div class="anbf-w">
      <div class="anbf-sh"><div><div class="anbf-eb">Calendário</div><h2>Como funciona</h2></div><p>{{ section.settings.como_txt | escape }}</p></div>
      <div class="anbf-tl">
        <div class="anbf-ph3" data-fase="1"><div class="w anbf-num">{{ section.settings.f1_quando | escape }}</div><h3>Esquenta</h3><p>{{ section.settings.f1_txt | escape }}</p></div>
        <div class="anbf-ph3" data-fase="2"><div class="w anbf-num">{{ section.settings.f2_quando | escape }}</div><h3>Black Friday</h3><p>{{ section.settings.f2_txt | escape }}</p></div>
        <div class="anbf-ph3" data-fase="3"><div class="w anbf-num">{{ section.settings.f3_quando | escape }}</div><h3>Cyber Monday</h3><p>{{ section.settings.f3_txt | escape }}</p></div>
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  var s=document.getElementById('black-friday'); if(!s) return;
  var ini=Date.parse(s.dataset.inicio+'T00:00:00-03:00'), fim=Date.parse(s.dataset.fim+'T23:59:59-03:00'), cy=Date.parse(s.dataset.cyber+'T00:00:00-03:00');
  var pad=function(n){return String(n).padStart(2,'0')};
  function t(){
    var a=Date.now(), alvo, rot, fase;
    if(a<ini){alvo=ini;rot='Começa em';fase='1'} else if(a<=fim){alvo=fim;rot='Termina em';fase=(a>=cy?'3':'2')} else {alvo=a;rot='Encerrada';fase='3'}
    var x=Math.max(0,Math.floor((alvo-a)/1000));
    var v={d:Math.floor(x/86400),h:Math.floor(x%86400/3600),m:Math.floor(x%3600/60),s:x%60};
    s.querySelectorAll('[data-bf]').forEach(function(e){e.textContent=pad(v[e.dataset.bf])});
    var r=s.querySelector('[data-bf-rotulo]'); if(r) r.textContent=rot;
    s.querySelectorAll('[data-fase]').forEach(function(e){e.classList.toggle('on',e.dataset.fase===fase)});
  }
  t(); setInterval(t,1000);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "AN · Black Friday",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "ativo", "label": "Mostrar a campanha", "default": true },
    { "type": "text", "id": "mostrar_desde", "label": "Mostrar a partir de (AAAA-MM-DD, vazio = já)" },
    { "type": "text", "id": "inicio", "label": "Início da Black Friday (AAAA-MM-DD)", "default": "2026-11-27" },
    { "type": "text", "id": "cyber", "label": "Cyber Monday (AAAA-MM-DD)", "default": "2026-11-30" },
    { "type": "text", "id": "fim", "label": "Fim da campanha (AAAA-MM-DD)", "default": "2026-11-30" },
    { "type": "text", "id": "datas_txt", "label": "Datas no topo", "default": "27 a 30 de novembro" },
    { "type": "text", "id": "desconto_max", "label": "Maior desconto", "default": "−39%" },
    { "type": "richtext", "id": "lead", "label": "Texto do topo", "default": "<p>O maior desconto do ano no <strong>ImunoFosfo</strong>. Garanta até <strong>6 meses de protocolo</strong> pelo menor preço por frasco que já fizemos.</p>" },
    { "type": "header", "content": "Kits do ImunoFosfo" },
    { "type": "product", "id": "produto_kits", "label": "Produto dos kits" },
