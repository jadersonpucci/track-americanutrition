{%- comment -%}
  Black Friday 2026 · America Nutrition (24/11/2026, pedido do Jaderson). Fica no lugar de snippets/an-esquenta-popup.liquid
  (o popup do Esquenta sai). Liga sozinho de qui 26/11 20h até seg 30/11 23h59 (Brasília); fora disso não mostra nada.
  Prévia antes da hora: ?black=preview no endereço (vale para a aba até fechar).
  1) Barra preta no topo de todas as páginas, com contagem até 30/11 23h59.
  2) Home: faixa da Black logo no começo da página.
  3) Páginas de produto da Black (lista igual à dos descontos automáticos da Shopify): a caixa de compra calcula a Black
     como o carrinho (conta todos os frascos da Black, inclusive o Ômega 3 adicionado junto), mostra o preço cheio
     riscado e esconde o campo de cupom (na Black cupom não soma).
{%- endcomment -%}
{%- assign anbf_handles = 'imunofosfo-fosfoetanolamina-phospho,imunofosfo-liquid,imunopet,imunofosfo-healing,imunofosfo-kids-fosfoetanolamina,omega-3-meg3,d3-vitamin-with-k2-and-a,propolis-extract,green-propolis-premium-propolis-verde,creatine-ultra-micronized,life-gummy-creatina-em-gomas,carvao-vegetal-ativado-activated-charcoal-premium,imunofosfo-phase-one,vitamins-minerals-premium,life-hair,life-protein-proteina-vegetal,imunofosfo-diabetes,vitamina-d3-50000-ui-k2-a-e' | split: ',' -%}
{%- assign anbf_pdp = false -%}
{%- if template.name == 'product' and anbf_handles contains product.handle -%}{%- assign anbf_pdp = true -%}{%- endif -%}
<style>
.anbf-bar{background:linear-gradient(90deg,#000 0%,#1c0303 50%,#000 100%);border-bottom:3px solid #07388E;position:sticky;top:0;z-index:25}
body.anbf-on .header-section.header-sticky{top:var(--anbf-h,0px)!important}
.anbf-bar a{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;padding:7px 14px;color:#fff;text-decoration:none;font-size:14px;line-height:1.2}
.anbf-tag{background:#AD0404;color:#fff;font-weight:800;letter-spacing:.12em;font-size:12px;padding:5px 10px;border-radius:999px;box-shadow:0 0 14px rgba(173,4,4,.55)}
.anbf-bar-t b{color:#fff;font-weight:800}
.anbf-cdl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#aab3c5}
.anbf-cdx{display:inline-flex;align-items:center;gap:3px}
.anbf-u{display:flex;flex-direction:column;align-items:center;min-width:36px;padding:4px 5px 3px;border-radius:7px;background:linear-gradient(180deg,#2b2b2b,#0f0f0f);border:1px solid #3a3a3a;box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}
.anbf-u b{font-size:17px;line-height:1;font-weight:900;color:#fff;font-variant-numeric:tabular-nums}
.anbf-u small{font-size:8.5px;line-height:1;letter-spacing:.1em;text-transform:uppercase;color:#9aa3b5;margin-top:3px}
.anbf-u.s{background:linear-gradient(180deg,#d30a0a,#7a0202);border-color:#e01b1b;box-shadow:0 0 12px rgba(211,10,10,.5)}
.anbf-u.s small{color:#ffd9d9}
.anbf-u b.tick{animation:anbfTick .35s ease-out}
.anbf-sep{color:#d30a0a;font-weight:900;font-size:16px;animation:anbfBlink 1s steps(1) infinite}
@keyframes anbfTick{0%{transform:translateY(-4px);opacity:.3}100%{transform:none;opacity:1}}
@keyframes anbfBlink{50%{opacity:.2}}
.anbf-home{background:linear-gradient(100deg,#000 0%,#0c1426 45%,#1c0303 100%);color:#fff;border-bottom:3px solid #07388E}
.anbf-home-in{max-width:1240px;margin:0 auto;padding:18px 24px;display:grid;grid-template-columns:minmax(260px,1fr) auto auto;gap:28px;align-items:center}
.anbf-h{font-size:26px;line-height:1.08;font-weight:900;margin:8px 0 6px;color:#fff;text-transform:uppercase;letter-spacing:-.01em}
.anbf-h span{color:#6f9bff}
.anbf-p{color:#aab6cc;font-size:13px;margin:0;line-height:1.4}
.anbf-tiers{display:grid;grid-template-columns:repeat(4,86px);gap:8px}
.anbf-tier{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.05);border-radius:12px;padding:9px 4px;text-align:center}
.anbf-tier span{display:block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#9fb0cf;font-weight:700}
.anbf-tier b{display:block;font-size:24px;line-height:1.1;font-weight:900;color:#fff;margin-top:2px}
.anbf-tier.top{border-color:#d30a0a;background:rgba(173,4,4,.25);box-shadow:0 0 16px rgba(211,10,10,.35)}
.anbf-hl{grid-column:2;font-size:12.5px;color:#c9d3e6;text-align:center;margin-top:-16px}
.anbf-dir{display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.anbf-ctas{display:flex;align-items:center;gap:14px}
.anbf-btn{display:inline-block;background:#AD0404;color:#fff;padding:11px 22px;border-radius:999px;font-weight:800;text-decoration:none;font-size:14px;box-shadow:0 0 14px rgba(173,4,4,.45)}
.anbf-btn2{color:#c9d3e6;font-size:13px;text-decoration:underline;text-underline-offset:3px}
.anbf-btn,.anbf-btn2{white-space:nowrap}
@media(max-width:980px){
  .anbf-home-in{grid-template-columns:1fr;gap:12px;padding:16px 16px;text-align:center}
  .anbf-home .anbf-cdx{display:none}
  .anbf-tiers{grid-template-columns:repeat(4,1fr);max-width:420px;margin:0 auto;width:100%}
  .anbf-hl{grid-column:auto;margin-top:-4px}
  .anbf-dir{align-items:center}
  .anbf-h{font-size:21px;margin:6px 0 4px}
}
@media(max-width:640px){
  .anbf-tier b{font-size:19px}
  .anbf-tier span{font-size:9px}
}
#anbf-pdp.anbf-pdp{background:#050505!important;color:#fff!important;border-radius:14px!important;padding:14px 14px 12px!important;margin:0 0 16px!important;border-bottom:3px solid #07388E!important;box-sizing:border-box}
#anbf-pdp .anbf-pdp-t{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13px;margin:0 0 10px!important;color:#c9d3e6}
#anbf-pdp .anbf-pdp-t b{letter-spacing:.06em;color:#fff}
#anbf-pdp .anbf-tag{font-size:11px;padding:4px 10px!important}
#anbf-pdp .anbf-chips{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
#anbf-pdp .anbf-chip{background:#151515;border:1.5px solid #2c2c2c;color:#fff;border-radius:10px;padding:9px 4px!important;margin:0!important;cursor:pointer;text-align:center;font:inherit;line-height:1.15}
#anbf-pdp .anbf-chip span{display:block;font-size:11px;color:#9fb0cf;text-transform:uppercase;letter-spacing:.06em}
#anbf-pdp .anbf-chip b{display:block;font-size:18px;font-weight:900;color:#fff;margin-top:2px}
#anbf-pdp .anbf-chip.on{border-color:#AD0404;background:#2a0606}
#anbf-pdp .anbf-pdp-n{font-size:12px;color:#9fb0cf;margin:9px 0 0!important;text-align:center;line-height:1.35}
body.anbf-on #bbVal,body.anbf-on #bbBumpRow span:last-child{white-space:nowrap;text-align:right;flex:none}
body.anbf-on #bbLabel{min-width:0}
.anbf-lbl{color:#AD0404;font-weight:800}
body.anbf-on #bbCup,body.anbf-on #bbCupRow,body.anbf-on #bbHint{display:none!important}
#anlp .offer-br-vis{align-self:start;min-height:0!important;background:#fff!important}
#anlp .offer-br-vis img{display:block;width:100%!important;height:auto!important;object-fit:contain!important}
@media(min-width:861px){#anlp .offer-br-vis{position:sticky;top:96px}}
@media(max-width:640px){
  .anbf-bar a{gap:8px;font-size:13px;padding:6px 8px}
  .anbf-bar .anbf-tag{font-size:10.5px;padding:4px 8px}
  .anbf-bar .anbf-u{min-width:28px;padding:3px 3px 2px;border-radius:6px}
  .anbf-bar .anbf-u b{font-size:14px}
  .anbf-bar .anbf-u small{font-size:7px}
  .anbf-bar .anbf-sep{font-size:12px}
  .anbf-bar-x{display:none}
  body.anbf-on #bbVal s,body.anbf-on #bbBumpRow s{display:block;margin:0!important;font-size:.85em;line-height:1.1}
}
</style>
<div id="anbf-bar" class="anbf-bar" hidden>
  <a href="/collections/america-nutrition">
    <span class="anbf-tag">BLACK FRIDAY</span>
    <span class="anbf-bar-t">Até <b>40% OFF</b><span class="anbf-bar-x"> · quanto mais frascos, maior o desconto</span></span>
    <span class="anbf-cdl anbf-bar-x">Termina em</span>
    <span class="anbf-cdx" data-anbf-cdx aria-label="Tempo restante"><span class="anbf-u"><b data-u="d">0</b><small>dias</small></span><span class="anbf-sep">:</span><span class="anbf-u"><b data-u="h">00</b><small>h</small></span><span class="anbf-sep">:</span><span class="anbf-u"><b data-u="m">00</b><small>min</small></span><span class="anbf-sep">:</span><span class="anbf-u s"><b data-u="s">00</b><small>seg</small></span></span>
  </a>
</div>
{%- if template.name == 'index' -%}
<section id="anbf-home" class="anbf-home" hidden aria-label="Black Friday America Nutrition">
  <div class="anbf-home-in">
    <div>
      <span class="anbf-tag">BLACK FRIDAY</span>
      <h2 class="anbf-h">Quanto mais frascos, <span>maior o desconto</span></h2>
      <p class="anbf-p">Desconto aplicado sozinho no carrinho, sem cupom. Até segunda, 30/11, às 23h59.</p>
    </div>
    <div class="anbf-tiers">
      <div class="anbf-tier"><span>1 frasco</span><b>20%</b></div>
      <div class="anbf-tier"><span>2 frascos</span><b>30%</b></div>
