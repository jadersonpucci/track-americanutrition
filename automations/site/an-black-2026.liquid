{%- if anbf_pdp -%}
<div id="anbf-pdp" class="anbf-pdp" hidden>
  <div class="anbf-pdp-t"><span class="anbf-tag">BLACK FRIDAY</span><span>Termina em <b data-anbf-cd>00d 00:00:00</b></span></div>
  <div class="anbf-chips">
    <button type="button" class="anbf-chip" data-n="1"><span>1 frasco</span><b>20%</b></button>
    <button type="button" class="anbf-chip" data-n="2"><span>2 frascos</span><b>30%</b></button>
    <button type="button" class="anbf-chip" data-n="3"><span>3 frascos</span><b>35%</b></button>
    <button type="button" class="anbf-chip" data-n="4"><span>4 ou mais</span><b>40%</b></button>
  </div>
  <div class="anbf-pdp-n">Desconto aplicado no carrinho, sem cupom. Vale para todos os produtos da Black no pedido.</div>
</div>
{%- endif -%}
<script>
(function(){
  var INI=Date.parse('2026-11-26T20:00:00-03:00'),FIM=Date.parse('2026-11-30T23:59:59-03:00');
  var prev=/[?&]black=preview/.test(location.search);
  try{if(prev)sessionStorage.setItem('anbf_prev','1');else if(sessionStorage.getItem('anbf_prev')==='1')prev=true;}catch(e){}
  var agora=Date.now();
  if(!prev&&(agora<INI||agora>FIM))return;
  function pad(n){return String(n).padStart(2,'0');}
  function relogio(){
    var d=Math.max(0,FIM-Date.now()),s=Math.floor(d/1000);
    var t=Math.floor(s/86400)+'d '+pad(Math.floor(s%86400/3600))+':'+pad(Math.floor(s%3600/60))+':'+pad(s%60);
    document.querySelectorAll('[data-anbf-cd]').forEach(function(el){el.textContent=t;});
    var u={d:String(Math.floor(s/86400)),h:pad(Math.floor(s%86400/3600)),m:pad(Math.floor(s%3600/60)),s:pad(s%60)};
    document.querySelectorAll('[data-anbf-cdx] b[data-u]').forEach(function(b){var v=u[b.getAttribute('data-u')];if(b.textContent!==v){b.textContent=v;if(b.getAttribute('data-u')==='s'){b.classList.remove('tick');void b.offsetWidth;b.classList.add('tick');}}});
    if(d<=0&&!prev){document.body.classList.remove('anbf-on');['anbf-bar','anbf-home','anbf-pdp'].forEach(function(i){var e=document.getElementById(i);if(e)e.hidden=true;});}
  }
  function brl(v){return 'R$ '+v.toFixed(2).replace('.',',').replace(/\B(?=(\d{3})+(?!\d))/g,'.');}
  function num(t){var m=String(t||'').match(/R\$\s*[\d.]+,\d{2}/g);if(!m)return 0;return parseFloat(m[m.length-1].replace(/R\$\s*/,'').replace(/\./g,'').replace(',','.'))||0;}
  function pct(n){return n>=4?40:n>=3?35:n>=2?30:n>=1?20:0;}
  function $(i){return document.getElementById(i);}
  function iniciar(){
    document.body.classList.add('anbf-on');
    var bar=$('anbf-bar');
    if(bar){document.body.insertBefore(bar,document.body.firstChild);bar.hidden=false;
      var alt=function(){document.documentElement.style.setProperty('--anbf-h',bar.offsetHeight+'px');};
      alt();window.addEventListener('resize',alt);setTimeout(alt,800);}
    var home=$('anbf-home');
    if(home){var main=document.querySelector('main')||document.getElementById('MainContent');if(main)main.insertBefore(home,main.firstChild);home.hidden=false;}
    relogio();setInterval(relogio,1000);
    var pdp=$('anbf-pdp'),parc=$('bbParcel');
    if(!pdp||!parc)return;
    var box=$('comprar')||document.querySelector('.bbx');
    if(box){box.insertBefore(pdp,box.firstChild);pdp.hidden=false;}
    function bumpOn(){var c=$('bbBumpChk');return !!(c&&c.checked);}
    function aplicar(){
      var qEl=$('bbQ'),val=$('bbVal'),lbl=$('bbLabel'),tot=$('bbTotal');
      if(!qEl||!val||!tot)return;
      var q=parseInt(qEl.textContent,10)||1;
      var s=val.querySelector('s');var cheio=s?num(s.textContent):num(val.textContent);
      var row=$('bbBumpRow'),bp=0;
      if(row){if(!row.dataset.anbfP){var sp=row.querySelectorAll('span');row.dataset.anbfP=String(num(sp.length?sp[sp.length-1].textContent:''));}bp=parseFloat(row.dataset.anbfP)||0;}
      var on=bumpOn(),n=q+(on?1:0),d=pct(n);
      var sub=cheio*(1-d/100),bv=on?bp*(1-d/100):0,total=sub+bv;
      var RS='<s data-bf="1" style="opacity:.55;font-weight:600;margin-right:6px">';
      if(lbl)lbl.textContent=lbl.textContent.replace(/\s*\((?:Black\s*)?[-−]\d+%\)\s*$/,'')+'  (Black −'+d+'%)';
      val.innerHTML=RS+brl(cheio)+'</s>'+brl(sub);
      if(row&&on){var sp2=row.querySelectorAll('span');if(sp2.length)sp2[sp2.length-1].innerHTML=RS+brl(bp)+'</s>'+brl(bv);}
      var fr=$('bbFrete'),msg=$('bbMsg'),barra=$('bbBar');
      if(barra)barra.style.width=Math.min(100,Math.round(total/250*100))+'%';
      if(fr&&msg){if(total>=250){fr.textContent='Grátis';fr.className='bb-g';msg.className='bb-msg ok';msg.textContent='✓ Você ganhou frete grátis';}
        else{fr.textContent='a calcular';fr.className='';msg.className='bb-msg';msg.innerHTML='Faltam <b>'+brl(250-total)+'</b> para o frete grátis';}}
      tot.textContent=brl(total);
      parc.innerHTML='<span data-bf="1"></span>ou <b>3x de '+brl(total/3)+'</b> sem juros · em até 12x';
      pdp.querySelectorAll('.anbf-chip').forEach(function(c){var k=parseInt(c.getAttribute('data-n'),10);c.classList.toggle('on',k===Math.min(n,4));});
      var cards=$('bbCards');
      if(cards){
        cards.querySelectorAll('.bb-price').forEach(function(el){
          if(!el.querySelector('s[data-bf]'))el.setAttribute('data-anbf-p',String(num(el.textContent)));
          var p=parseFloat(el.getAttribute('data-anbf-p'))||0;
          if(p>0)el.innerHTML='<s data-bf="1">'+brl(p)+'</s>'+brl(p*(1-d/100));
        });
        var lb=cards.previousElementSibling;
        if(lb&&lb.classList.contains('bb-lbl')){var t=lb.querySelector('.anbf-lbl');if(!t){t=document.createElement('span');t.className='anbf-lbl';lb.appendChild(t);}t.textContent=' · preço com '+d+'% OFF da Black';}
      }
    }
    new MutationObserver(function(){if(!parc.querySelector('[data-bf]'))aplicar();}).observe(parc,{childList:true,characterData:true,subtree:true});
    var bc=$('bbBumpChk');if(bc)bc.addEventListener('change',function(){setTimeout(aplicar,0);});
    pdp.querySelectorAll('.anbf-chip').forEach(function(c){c.addEventListener('click',function(){
      var alvo=Math.max(1,parseInt(c.getAttribute('data-n'),10)-(bumpOn()?1:0)),i=0;
      while(i++<120){var q=parseInt(($('bbQ')||{}).textContent,10)||1;if(q===alvo)break;var b=$(q<alvo?'bbPlus':'bbMinus');if(!b)break;b.click();}
      aplicar();
    });});
    aplicar();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){setTimeout(iniciar,0);});else setTimeout(iniciar,0);
})();
</script>
