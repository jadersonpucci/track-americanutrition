{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/collections/:c/products/:p",
      "destination": "/products/:p",
      "permanent": true
    },
    {
      "source": "/account/:rest*",
      "destination": "/account",
      "permanent": false
    },
    {
      "source": "/checkout",
      "destination": "/cart",
      "permanent": false
    },
    {
      "source": "/checkouts/:rest*",
      "destination": "/cart",
      "permanent": false
    },
    {
      "source": "/stories",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pt-br/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/blogs/:b/tagged/:t",
      "destination": "/blogs/:b",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(products|collections|pages)\\.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}